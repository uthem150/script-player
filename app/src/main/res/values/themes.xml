<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      런처가 창을 띄울 때 쓰는 테마. 실제 색·타이포는 Compose 쪽 AppTheme 이 정한다.

      부모를 Light 로 두는 것이 중요하다. 앞서 android:Theme.Material.NoActionBar 로
      두었는데 그것은 **어두운** 테마라(밝은 쪽은 .Light), 창 배경이 어두운 채로 남아
      화면 위쪽만 색이 달라 보였다.

      시스템 바 아이콘 색은 여기서 만지지 않는다 — MainActivity 의 enableEdgeToEdge() 가
      테마에 맞춰 알아서 맞춘다.
    -->
    <style name="Theme.ScriptPlayer" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
