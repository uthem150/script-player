<!--
  앱 아이콘의 그림 층.

  대본(글줄)이 소리(재생)로 바뀐다는 것 하나만 그린다.

  처음 시안은 **화살표로 보였다** — 글줄이 화살대, 삼각형이 화살촉이 됐다.
  원인은 둘 사이 틈이 3 밖에 안 됐던 것과, 글줄이 삼각형 세로 가운데에만
  걸쳐 있던 것이다. 그래서
    · 글줄을 셋으로 늘려 삼각형 높이 전체를 덮고 («≡» = 글) ,
    · 길이를 모두 같게 하고 (길이를 달리하면 다시 화살대가 된다) ,
    · 사이 틈을 12 로 벌렸다.

  108 짜리 화면에서 가운데 66 (21~87) 만 어느 런처에서나 보인다 — 바깥은
  모양대로 깎인다. 그림은 x 24~82 · y 32~76 안에 있고 좌우·상하 모두 54 를
  중심으로 맞췄다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 글줄 셋 — 높이 9, 간격 6. 48dp 로 줄어도 남을 두께다 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M24,34.5 h13 a4.5,4.5 0 0 1 0,9 h-13 a4.5,4.5 0 0 1 0,-9 z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M24,49.5 h13 a4.5,4.5 0 0 1 0,9 h-13 a4.5,4.5 0 0 1 0,-9 z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M24,64.5 h13 a4.5,4.5 0 0 1 0,9 h-13 a4.5,4.5 0 0 1 0,-9 z" />

    <!-- 재생 — 왼쪽 변은 x=54 수직, 꼭짓점 셋만 둥글려 아이콘 모서리와 어울리게 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M57.5,32.5 L82,51.5 a4,4 0 0 1 0,5 L57.5,75.5 a3.5,3.5 0 0 1 -3.5,-3.5 L54,36 a3.5,3.5 0 0 1 3.5,-3.5 z" />
