<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      android.permission.INTERNET 을 일부러 선언하지 않는다.
      기기에 설치된 TTS 음성으로만 합성하므로 네트워크가 필요 없고,
      필요 없다는 것을 매니페스트로 못 박아 둔다.

      포그라운드 서비스 권한은 재생을 위한 것이다 — 화면을 끈 뒤에도 계속 돌게 한다.
    -->

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 알림이 안 보이면 잠금화면 컨트롤을 쓸 수 없다 (Android 13+ 는 런타임 요청) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 설치된 TTS 엔진을 조회하려면 이 쿼리가 있어야 한다 (Android 11+ 패키지 가시성) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".ScriptPlayerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScriptPlayer">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              다른 앱에서 텍스트를 공유하면 여기로 들어온다.
              데스크톱에서 만든 대본을 메신저로 자신에게 보내고, 폰에서 길게 눌러
              "공유 → 대본 플레이어" 로 던져 넣는 흐름이 이 앱의 주된 유입 경로다.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>
